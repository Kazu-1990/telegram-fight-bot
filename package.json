{
  "name": "telegram-fight-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute fight-bot-db --local --file=./src/db/schema.sql",
